# Any Vercel-compatible Postgres connection string works:
# Vercel Postgres, Neon, or Supabase all provide one of these.
DATABASE_URL=postgres://user:password@host:5432/dbname

# Shared password gating the /admin RSVP management page.
ADMIN_SECRET=change-me

# Shared password gating the /photos page. Give this one to
# attendees; keep ADMIN_SECRET separate so you don't have to share
# edit/delete access just to let people see photos.
RSVP_LIST_SECRET=change-me-too

# The share token from your iCloud shared album's URL, e.g. the part
# after /shared/album/ in https://photos.icloud.com/shared/album/<token>.
# Anyone who has this token can open the album directly on iCloud
# regardless of RSVP_LIST_SECRET, so keep it out of source control —
# that's exactly why it's read from an env var instead of hardcoded.
ALBUM_TOKEN=your-icloud-share-token
